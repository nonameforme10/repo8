# Copy to .env and fill in. PM2 reads these (or set them in the PM2 ecosystem file).

# Port the Express app listens on (Nginx proxies to this). Avoid ports used by caretrack/portfolio-api.
PORT=5000

# Your Realtime Database URL — find it in Firebase Console > Realtime Database.
# Default (US) pattern for project "ipilisation":
FIREBASE_DB_URL=https://ipilisation-default-rtdb.firebaseio.com

# Restrict cross-origin calls to your frontend domain(s) in production.
# Accepts '*', a single origin, or a comma-separated list:
# ALLOWED_ORIGIN=https://hunterstar.online,https://www.hunterstar.online,https://project-a6psa-navy.vercel.app
ALLOWED_ORIGIN=*

# OPTIONAL: instead of a serviceAccountKey.json file, paste the whole service-account
# JSON on one line here. Either this OR the file is required for logging.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ipilisation", ...}
